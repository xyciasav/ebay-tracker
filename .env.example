# Copy this file to .env and replace every value before running Docker Compose.
FLASK_SECRET_KEY=replace-with-a-long-random-value
BASIC_AUTH_USER=replace-with-your-username
BASIC_AUTH_PASS=replace-with-a-strong-password

# Optional upload limits.
MAX_UPLOAD_BYTES=20971520
MAX_PHOTOS_PER_ITEM=12

# Optional: enables Scanner > Shelf Photo Triage.
# For LM Studio/OpenAI-compatible local vision, set LM_STUDIO_URL or VISION_API_BASE.
# Example: LM_STUDIO_URL=http://10.0.0.156:1234
LM_STUDIO_URL=
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=
VISION_MAX_TOKENS=1600
VISION_RESPONSE_FORMAT=json_object
VISION_TEMPERATURE=0

# Hosted OpenAI fallback if no local vision URL is configured.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5
